# Postgres for the service store
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/aomi_telegram
# 32-byte hex key that seals tenant bot tokens at rest
SERVICE_KEY=
# Public HTTPS origin of the worker, used to build webhook URLs
PUBLIC_URL=https://tg.aomi.dev
# Bot API base; point at a fake for local runs
TELEGRAM_API_BASE=https://api.telegram.org
# Set false only against a fake Telegram that sends no secret header
VERIFY_WEBHOOK_SECRET=true
PORT=8790
