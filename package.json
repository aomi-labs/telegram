    "onboard": "pnpm --filter @aomi-telegram/worker onboard"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
